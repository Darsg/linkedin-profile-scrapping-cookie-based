# Copy to .env (repo root). All values below are local-dev defaults.

# --- infrastructure -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://linkedin:linkedin@localhost:5433/linkedin
REDIS_URL=redis://localhost:6380/0

# --- data source: mock | playwright | api ---------------------------------
PROVIDER=mock
# Re-use a stored profile instead of re-scraping if it is newer than this.
PROFILE_TTL_HOURS=24

# --- playwright provider (your own logged-in LinkedIn session) ------------
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_MIN_DELAY_SECONDS=30
PLAYWRIGHT_DAILY_CAP=40
PLAYWRIGHT_MAX_ACTIVITIES=10

# --- api provider (Apify actor) -------------------------------------------
APIFY_TOKEN=
APIFY_ACTOR_ID=
# Name of the actor input field that takes the list of profile URLs.
APIFY_INPUT_FIELD=profileUrls

# --- frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
